    "/api/files/get_all_names": {
      "get": {
        "tags": [
          "Storage for files"
        ],
        "summary": "Get the names and uuids of all files",
        "description": "This request returns a list of the ```name``` and ```asset_uuid``` of all files present in the database.",
        "operationId": "get_all_names",
        "responses": {
          "200": {
