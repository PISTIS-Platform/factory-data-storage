    "/api/files/create_file": {
      "post": {
        "tags": [
          "Storage for files"
        ],
        "summary": "Create a new file",
        "description": "This endpoint is to add a new file into the database or to create a new version of an existing file.",
        "operationId": "addFile",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Upload the file",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New file created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asset_uuid": {
                      "type": "string",
                      "example": "ae755a90-b7bc-4c28-bfc8-7a4fb247328b"
                    },
                    "message": {
                      "type": "string",
                      "example": "New file created"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "New version of the file created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asset_uuid": {
                      "type": "string",
                      "example": "ae755a90-b7bc-4c28-bfc8-7a4fb247328b"
                    },
                    "message": {
                      "type": "string",
                      "example": "New version of the file created"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters",
            "content": {}
          }
        },
        "security": [
          {
            "key": []
          }
        ]
      }
    },
